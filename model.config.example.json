{
  "_说明": "复制本文件为 model.config.json 并填入 apiKey。model.config.json 已 gitignore，不会进仓库。也可以不落地文件，直接设环境变量 INNO_API_KEY。字段与上游 inno-agent/config.example.json 同构。",
  "defaultProvider": "innospark",
  "defaultModel": "claude-sonnet-4-6",
  "providers": {
    "innospark": {
      "baseUrl": "https://api.innospark.cn",
      "api": "anthropic-messages",
      "apiKey": "replace-me",
      "authHeader": false,
      "models": [
        {
          "id": "claude-sonnet-4-6",
          "name": "Claude Sonnet 4.6 via InnoSpark",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 200000,
          "maxTokens": 16384
        }
      ]
    }
  }
}
